{
	"name": "ls-layerbase",
	"version": "0.0.0",
	"description": "A Nuxt layer with the plumbing that small, self-hosted Nuxt apps tend to rewrite for each project.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/seanlindell/LS-Layerbase.git"
	},
	"main": "./nuxt.config.ts",
	"files": [
		"nuxt.config.ts",
		"app",
		"server",
		"shared"
	],
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=22.22.3"
	},
	"scripts": {
		"dev": "nuxt dev playground",
		"build": "nuxt build playground",
		"preview": "nuxt preview playground",
		"prepare:playground": "nuxt prepare playground",
		"postinstall": "nuxt prepare playground",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"typecheck": "nuxt typecheck playground && tsc -p test/tsconfig.json",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:routes": "vitest run --project routes",
		"test:watch": "vitest --project unit"
	},
	"devDependencies": {
		"@nuxt/eslint": "^1.17.0",
		"@nuxt/test-utils": "^4.4.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"better-sqlite3": "^13.0.3",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.14.0",
		"h3": "^1.15.11",
		"nuxt": "^4.6.4",
		"ofetch": "^1.5.1",
		"pg": "^8.23.1",
		"prettier": "^3.10.0",
		"typescript": "^5.9.3",
		"vitest": "^5.1.0",
		"vue": "^3.5.45",
		"vue-router": "^5.5.0",
		"vue-tsc": "^3.3.14"
	},
	"peerDependencies": {
		"drizzle-orm": ">=0.44.0 <1.0.0",
		"nuxt": "^4.0.0",
		"vue": "^3.5.0"
	}
}
